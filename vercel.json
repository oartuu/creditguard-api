{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/analysis/(.*)",
      "dest": "backend/run.py"
    },
    {
      "src": "/prepare-data",
      "dest": "backend/run.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
